# Kopieren nach .env.local

# Azure (Foundry) – OpenAI-v1-kompatibler Endpunkt
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_CHAT_DEPLOYMENT=<deployment-name-GPT-6-Astra>
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Ordner mit PDFs, metadaten.jsonl und Suchindex (gitignored)
DATA_DIR=./data

# DIP-API (Bundestag): Key unter dip.bundestag.de > Über DIP > Hilfe > API
# https://dip.bundestag.de/%C3%BCber-dip/hilfe/api
DIP_API_KEY=

# Nutzungsprotokoll (pm2 logs und data/logs/nutzung.jsonl): on/off und IP-Adresse full/anon/off
# USAGE_LOG=on
# USAGE_LOG_IP=anon

# Grenzen für Treffer (Anzahl Dokumente), Standardwerte:
# CHECK_PRO_SUCHE=20     Treffer je Suchanfrage im Anfragen-Check
# CHECK_MAX_TREFFER=50   Fundstellen je Einzelfrage insgesamt
# CHECK_ANZEIGE=20       zuerst angezeigt, Schrittweite von „Weitere anzeigen“
# CHECK_BEWERTET=6       so viele Treffer bewertet GPT (mehr = mehr Token)
# SUCHE_MAX=100          Maximum auf „Antworten durchsuchen“
